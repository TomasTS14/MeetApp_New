# From `supabase status` (local) or the Supabase dashboard (Project Settings > API).
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: address search when creating events (Mapbox, free tier). Without it the event is
# placed at the organizer's current location and the address is typed by hand.
EXPO_PUBLIC_MAPBOX_TOKEN=

# Optional: the public web address of the app, e.g. https://meetapp.es. Shared event links
# point there. Without it the web app uses its own address and the phone app its own link.
EXPO_PUBLIC_WEB_URL=
